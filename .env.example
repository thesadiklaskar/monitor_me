# Local development only. Replace both passwords before using a shared environment.
POSTGRES_DB=monitor_me
POSTGRES_USER=monitor_me
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=5432

REDIS_PASSWORD=local_only_change_me
CLICKHOUSE_PASSWORD=local_only_change_me
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.44.3
REDIS_PORT=6379

API_PORT=8080
AGENT_GRPC_PORT=8443
# Public gRPC address monitored Linux hosts use to reach this control plane.
AGENT_GRPC_PUBLIC_ADDRESS=localhost:8443
# Browser-facing API origin. In production, use the HTTPS reverse-proxy origin.
MONITOR_ME_PUBLIC_API_URL=http://localhost:8080
WEB_ALLOWED_ORIGINS=http://localhost:3000
# Remote systemd operations are disabled until an explicit server-side allowlist is configured.
REMOTE_ALLOWED_SYSTEMD_UNITS=
WEB_PORT=3000
