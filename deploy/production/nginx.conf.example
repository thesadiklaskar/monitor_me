# Install as /etc/nginx/conf.d/monitor-me.conf after replacing the hostname.
# Nginx terminates browser HTTPS; API gRPC independently terminates TLS on :8443.
map $http_upgrade $monitor_me_connection_upgrade {
    default upgrade;
    ''      close;
}
limit_req_zone $binary_remote_addr zone=monitor_me_agent_bootstrap:10m rate=10r/m;
server {
    listen 80;
    listen [::]:80;
    server_name monitor.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name monitor.example.com;
    ssl_certificate     /etc/letsencrypt/live/monitor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitor.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 2m;

    # Public, rate-limited bootstrap routes: installers, CA and signed-by-checksum
    # native binaries. These contain no operator data or persistent enrollment secrets.
    location = /install/agent-linux.sh {
        limit_req zone=monitor_me_agent_bootstrap burst=10 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store";
    }
    location = /install/agent-windows.ps1 {
        limit_req zone=monitor_me_agent_bootstrap burst=10 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store";
    }
    location = /api/agent-artifacts/manifest {
        limit_req zone=monitor_me_agent_bootstrap burst=10 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store";
    }
    location ^~ /api/agent-artifacts/ {
        limit_req zone=monitor_me_agent_bootstrap burst=10 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/agent-ca {
        limit_req zone=monitor_me_agent_bootstrap burst=10 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store";
    }

    # The app UI, normal API routes and live stream have owner-level access
    # in the no-login profile. Only administrators/VPN users may reach them.
    location = /v1/live/ws {
        include /etc/nginx/snippets/monitor-me-admin-allowlist.conf;
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $monitor_me_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location / {
        include /etc/nginx/snippets/monitor-me-admin-allowlist.conf;
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
