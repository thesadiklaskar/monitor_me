# Copy to .env.production, set unique secrets, and keep it out of version control.
# URL-encode reserved characters in DATABASE_URL credentials.
MONITOR_ME_RELEASE=0.1.0
# Required: set the public DNS name or IP covered by the HTTPS certificate.
PUBLIC_HOSTNAME=
# Required: set the reachable control-plane host and gRPC port.
AGENT_GRPC_PUBLIC_ADDRESS=
# Replace with the trusted operator/VPN source CIDR before deployment.
# The deploy helper applies this to SSH and the Nginx dashboard/API/WebSocket allowlist.
# Public node installer/CA/artifact routes remain available over HTTPS.
ADMIN_CIDR=REPLACE_WITH_OPERATOR_PUBLIC_CIDR
AGENT_GRPC_BIND_ADDRESS=0.0.0.0
AGENT_GRPC_PORT=8443
API_HTTP_BIND_PORT=18080
WEB_BIND_PORT=13000
AGENT_TLS_CERT_DIR=/var/lib/monitor-me/certs
CERT_GROUP_ID=15001
POSTGRES_DB=monitor_me
POSTGRES_USER=monitor_me
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_LONG_RANDOM_SECRET
CLICKHOUSE_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_LONG_RANDOM_SECRET
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.44.3
# Grafana OSS companion UI; the installer replaces these placeholders with random secrets.
GRAFANA_IMAGE=grafana/grafana:13.3.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_SECRET
GRAFANA_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_SECRET
DATABASE_URL=postgres://monitor_me:URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/monitor_me?sslmode=disable
# Remote systemd actions remain disabled until specific units are approved.
