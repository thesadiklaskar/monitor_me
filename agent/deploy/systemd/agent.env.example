# Copy to /etc/monitor-me/agent.env and chmod 0600.
MONITOR_AGENT_VERSION=0.1.0
MONITOR_GRPC_ADDRESS=monitor.example.com:8443
MONITOR_TLS_CA_FILE=/etc/monitor-me/server-ca.crt
# Set only for initial enrollment or an explicit re-enrollment.
# Remove MONITOR_ENROLLMENT_TOKEN after the private agent state file is created.
# MONITOR_ENROLLMENT_TOKEN=

# Optional remote operations are disabled unless a strict local allowlist is set.
# Keep this list consistent with REMOTE_ALLOWED_SYSTEMD_UNITS on the control plane.
# MONITOR_ALLOWED_SYSTEMD_UNITS=monitor-me-worker.service,sshd.service
